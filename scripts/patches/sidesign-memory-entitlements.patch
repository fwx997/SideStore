--- /dev/null
+++ b/Sources/CodeSigning/MemoryEntitlements.swift
@@ -0,0 +1,53 @@
+import Foundation
+import CoreFoundation
+
+/// The increased-memory request belongs to each executable's signature. It must
+/// not disappear merely because the profile does not repeat this optional key.
+/// iOS still decides whether the signed app and its memory request are supported.
+public enum MemoryEntitlements {
+    public static let keys: Set<String> = [
+        "com.apple.developer.kernel.increased-memory-limit"
+    ]
+
+    public static func values(in entitlements: [String: any Sendable]) -> [String: any Sendable] {
+        entitlements.filter { keys.contains($0.key) }
+    }
+
+    public static func applying(
+        requested: [String: any Sendable],
+        to entitlements: [String: any Sendable]
+    ) throws -> [String: any Sendable] {
+        var result = entitlements
+        for key in keys.sorted() {
+            guard let value = requested[key] else {
+                result.removeValue(forKey: key)
+                continue
+            }
+            result[key] = try boolean(value, key: key)
+        }
+        return result
+    }
+
+    public static func validate(
+        expected: [String: any Sendable],
+        actual: [String: any Sendable]
+    ) throws {
+        for (key, value) in values(in: expected) {
+            let requested = try boolean(value, key: key)
+            guard let actualValue = actual[key],
+                  try boolean(actualValue, key: key) == requested else {
+                throw SignerError.invalidApp(
+                    cause: "The signed executable did not retain the requested memory entitlement '\(key)'."
+                )
+            }
+        }
+    }
+
+    private static func boolean(_ value: any Sendable, key: String) throws -> Bool {
+        guard let number = value as? NSNumber,
+              CFGetTypeID(number) == CFBooleanGetTypeID() else {
+            throw SignerError.invalidApp(cause: "The memory entitlement '\(key)' must be a Boolean.")
+        }
+        return number.boolValue
+    }
+}
